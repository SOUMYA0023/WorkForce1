# ═══════════════════════════════════════════════════════════════════════
# WorkForce One — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in actual values.
# Self-hosted PostgreSQL on VPS (ADR §1) — no Supabase dependencies.

# ── Database ────────────────────────────────────────────────────────────
# Self-hosted PostgreSQL on the same VPS (IR-001)
DATABASE_URL=postgresql://workforce_user:password@localhost:5432/workforce_one

# ── NextAuth ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ── App Configuration ───────────────────────────────────────────────────
NODE_ENV=development

# ── QR Token Configuration ─────────────────────────────────────────────
# How often the QR code regenerates on the employee's screen
QR_TOKEN_REFRESH_INTERVAL_SECONDS=15
# How long a generated token remains valid for scanning
QR_TOKEN_VALIDITY_SECONDS=30

# ── Session Configuration ──────────────────────────────────────────────
# Database sessions (ADR §3) — timeout after inactivity
SESSION_TIMEOUT_MINUTES=30

# ── Rate Limiting ───────────────────────────────────────────────────────
# Applied to sensitive endpoints: token validation, login, export (SR-008)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
